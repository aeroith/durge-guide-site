 "narrative": {
  "northStar": "The Game's Own Screens",
  "overview": "The mod has no interface of its own, and the site's controls and frames are the grammar of the game's interface, redrawn in our own CSS and SVG. Later-story screenshots sit behind wax seals, because hiding things is what the mod does.",
  "keyCharacteristics": [
   "Near-black panels with a gold hairline, on an oxblood ground.",
   "Blackletter for names and questions, a calm text face for everything read.",
   "Real captures as the proof. Ornament is only ever our own CSS and SVG.",
   "One authored motion per moment.",
   "Works without JavaScript."
  ],
  "rules": [
   {
    "name": "The Metal Is Thin Rule",
    "body": "Gold is a hairline or a small word. It never fills a surface, except a plaque being pressed.",
    "section": "colors"
   },
   {
    "name": "The Blood Is Rare Rule",
    "body": "Blood marks where you are or what is sealed.",
    "section": "colors"
   },
   {
    "name": "The Blackletter Is For Names Rule",
    "body": "Grenze Gotisch is only for headings of 1.5rem or more.",
    "section": "typography"
   },
   {
    "name": "The Line Not Shadow Rule",
    "body": "If a surface needs lifting, it gets a darker ground and a hairline.",
    "section": "elevation"
   }
  ],
  "dos": [
   "Do put every fact, count and test result in as written.",
   "Do keep later-story captures behind a seal.",
   "Do cut new crops from docs/img and declare them in images.py.",
   "Do give every motion a reduced-motion path.",
   "Do keep the site fully working with scripts off."
  ],
  "donts": [
   "Don't use a kicker above a heading, section numbers, gradient text or glass.",
   "Don't use a thick coloured edge on a callout.",
   "Don't use radial glows.",
   "Don't draw particles or anything else over a capture.",
   "Don't copy Larian's logo, or make the site look official.",
   "Don't add a light theme as the identity."
  ]
